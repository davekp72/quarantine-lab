#cloud-config
hostname: quarantine-gateway
manage_etc_hosts: true
users:
  - name: __GATEWAY_USER__
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) ALL
    lock_passwd: false
    passwd: '__GATEWAY_PASSWORD_HASH__'
    ssh_authorized_keys:
      - __GATEWAY_SSH_PUBKEY__
ssh_pwauth: false
package_update: true
packages:
  - openssh-server
  - nftables
  - dnsmasq
  - tcpdump
  - python3
  - python3-pip
  - python3-venv
  - curl
  - openssl
runcmd:
  - mkdir -p /opt/quarantine-gateway-src
  - |
    if [ -d /mnt/quarantine-gateway ]; then
      cp -a /mnt/quarantine-gateway/. /opt/quarantine-gateway-src/
      chmod +x /opt/quarantine-gateway-src/first-boot.sh
      /opt/quarantine-gateway-src/first-boot.sh
    fi
  - chmod +x /opt/quarantine-gateway-src/scripts/harden-ssh.sh 2>/dev/null || true
final_message: "Quarantine Gateway cloud-init finished"
