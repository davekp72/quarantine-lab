[Unit]
Description=Quarantine FakeNet-NG (LAN sinkhole)
After=network-online.target nftables.service
Wants=network-online.target
Conflicts=quarantine-mitm-explicit.service quarantine-mitm-transparent.service dnsmasq.service

[Service]
Type=simple
User=quarantine-fakenet
Group=quarantine-fakenet
WorkingDirectory=/var/log/quarantine/fakenet
# '+' = root: create users/dirs/CA perms before drop.
ExecStartPre=+/usr/local/sbin/quarantine-ensure-service-users
ExecStart=/opt/quarantine-gateway/venv-fakenet/bin/python -m fakenet.fakenet \
  -c /etc/quarantine-gateway/fakenet.ini \
  -n -p \
  -l /var/log/quarantine/fakenet/fakenet.log
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ReadWritePaths=/var/log/quarantine/fakenet /var/lib/quarantine-fakenet /etc/quarantine-gateway /run /opt/quarantine-gateway/venv-fakenet
ReadOnlyPaths=/opt/quarantine-gateway/fakenet
# NFQUEUE / iptables divert + privileged listeners (:53/:80/:443/:25/:8080)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
# FakeNet touches netfilter; keep sysctl path usable.
ProtectKernelTunables=false

[Install]
WantedBy=multi-user.target
