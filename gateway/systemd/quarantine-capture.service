[Unit]
Description=Quarantine gateway packet capture (tcpdump LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quarantine-capture
Group=quarantine-capture
EnvironmentFile=-/etc/quarantine-gateway/ifaces.env
ExecStartPre=+/usr/local/sbin/quarantine-ensure-service-users
ExecStart=/usr/local/sbin/quarantine-capture-start
ExecStop=/usr/local/sbin/quarantine-capture-stop
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# /run so the legacy /run/quarantine-capture.path marker is writable (ProtectSystem=strict).
ReadWritePaths=/var/log/quarantine/pcap /run/quarantine /run
ReadOnlyPaths=/etc/quarantine-gateway /usr/local/sbin /sys/class/net
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
# Distro tcpdump profile only allows -w under /tmp and /var/log/tcpdump.
AppArmorProfile=unconfined

[Install]
WantedBy=multi-user.target
