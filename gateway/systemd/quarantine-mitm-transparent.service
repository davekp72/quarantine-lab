[Unit]
Description=Quarantine mitmproxy (transparent :8082)
After=network-online.target quarantine-mitm-explicit.service
Wants=network-online.target

[Service]
Type=simple
User=quarantine-mitm
Group=quarantine-mitm
Environment=QUARANTINE_ACCESS_LOG=/var/log/quarantine/proxy/access-transparent.log
Environment=QUARANTINE_ERROR_LOG=/var/log/quarantine/proxy/errors.log
Environment=QUARANTINE_FLOWS_JSONL=/var/log/quarantine/proxy/flows-transparent.jsonl
Environment=QUARANTINE_PAC_PATH=/etc/quarantine-gateway/quarantine.pac
Environment=QUARANTINE_CA_PATH=/var/lib/quarantine-mitm/mitmproxy-ca-cert.pem
ExecStartPre=+/usr/local/sbin/quarantine-ensure-service-users
ExecStart=/opt/quarantine-gateway/venv/bin/mitmdump \
  --mode transparent \
  --listen-host 0.0.0.0 \
  --listen-port 8082 \
  --set block_global=false \
  --set ipv6=false \
  --set confdir=/var/lib/quarantine-mitm \
  -s /etc/quarantine-gateway/block_private.py \
  --set hardcopy=/var/log/quarantine/proxy/flows-transparent.mitm
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/quarantine-mitm /var/log/quarantine/proxy
ReadOnlyPaths=/etc/quarantine-gateway /opt/quarantine-gateway/venv
# Transparent mode needs SO_ORIGINAL_DST (CAP_NET_ADMIN).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
